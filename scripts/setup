#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
command -v uv >/dev/null || { echo 'Install uv, then rerun scripts/setup.' >&2; exit 3; }
if command -v cargo >/dev/null; then
  CARGO_BIN="$(command -v cargo)"
elif [[ -x /opt/homebrew/opt/rustup/bin/cargo ]]; then
  CARGO_BIN=/opt/homebrew/opt/rustup/bin/cargo
else
  echo 'Install Rust with rustup, then rerun scripts/setup.' >&2
  exit 3
fi
uv sync --locked --python 3.11
"$CARGO_BIN" build --locked --manifest-path pipeline/Cargo.toml --bins
"$ROOT/scripts/doctor"
