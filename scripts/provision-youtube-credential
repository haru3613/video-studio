#!/bin/sh
# Browser-mediated, user-present provisioning for the protected YouTube credential.
set -eu

if [ "$(uname -s)" != "Darwin" ]; then
  printf '%s\n' 'This provisioning path requires a local macOS user session.' >&2
  exit 1
fi
if [ ! -t 0 ] || [ ! -t 1 ]; then
  printf '%s\n' 'Run this command interactively from a local macOS terminal.' >&2
  exit 1
fi

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
restore_terminal() {
  stty echo
}
trap restore_terminal EXIT HUP INT TERM
printf '%s\n' 'YouTube credential provisioning (1/3)'
printf '%s\n' 'A Google OAuth desktop-client JSON file is required outside this repository.'
printf '%s' 'Private client configuration path (input hidden): '
stty -echo
IFS= read -r client_config
stty echo
printf '\n'
if [ -z "$client_config" ]; then
  printf '%s\n' 'A client configuration file is required.' >&2
  exit 1
fi
if [ ! -f "$client_config" ]; then
  printf '%s\n' 'The supplied client configuration file is not available.' >&2
  exit 1
fi

printf '%s\n' 'YouTube credential provisioning (2/3)'
printf '%s\n' 'The next step opens Google consent in your default browser.'
printf '%s\n' 'Select the account that owns the canonical channel and grant exactly the requested permissions.'
printf '%s' 'Continue and create/replace the external protected credential? [y/N] '
IFS= read -r confirmation
case "$confirmation" in
  y|Y|yes|YES) ;;
  *) printf '%s\n' 'Cancelled without changing credentials.'; exit 0 ;;
esac

printf '%s\n' 'YouTube credential provisioning (3/3)'
YOUTUBE_OAUTH_CLIENT_FILE=$client_config exec python3 \
  "$repo_root/tools/youtube_credentials.py" provision --repo-root "$repo_root"
