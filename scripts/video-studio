#!/bin/sh -p
set -eu

case "$0" in
  */*) SCRIPT_DIR=${0%/*} ;;
  *) SCRIPT_DIR=. ;;
esac
ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"

if [ -x "$ROOT/pipeline/target/release/video-studio" ]; then
  exec "$ROOT/pipeline/target/release/video-studio" "$@"
fi
if [ -x "$ROOT/pipeline/target/debug/video-studio" ]; then
  exec "$ROOT/pipeline/target/debug/video-studio" "$@"
fi

printf '%s\n' 'video-studio: CLI binary missing; run cargo build --manifest-path pipeline/Cargo.toml --bin video-studio' >&2
exit 5
